<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChessDatabase.Api\ChessDatabase.Api.csproj" />
    <ProjectReference Include="..\ChessDatabase.FakeEngine\ChessDatabase.FakeEngine.csproj" />
  </ItemGroup>

  <!--
    The smoke tests drive the built UI (ui/dist), which the backend serves. Building this project
    runs the UI's unit specs (npm test) and builds the UI first, so `dotnet test` always tests the
    current UI. Both are skipped when nothing under ui/ changed since the last UI build; pass
    -p:SkipUiBuild=true to skip them anyway.
  -->
  <PropertyGroup>
    <UiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\ui'))</UiRoot>
  </PropertyGroup>

  <ItemGroup>
    <UiSource Include="$(UiRoot)\src\**\*" />
    <UiSource Include="$(UiRoot)\angular.json;$(UiRoot)\package.json;$(UiRoot)\package-lock.json;$(UiRoot)\tsconfig*.json" />
  </ItemGroup>

  <Target Name="InstallUiPackages" BeforeTargets="BuildUi" Condition="'$(SkipUiBuild)' != 'true' And !Exists('$(UiRoot)\node_modules')">
    <Exec Command="npm ci" WorkingDirectory="$(UiRoot)" />
  </Target>

  <Target Name="BuildUi" BeforeTargets="Build" Condition="'$(SkipUiBuild)' != 'true'"
          Inputs="@(UiSource)" Outputs="$(UiRoot)\dist\ui\browser\index.html">
    <Exec Command="npm test" WorkingDirectory="$(UiRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(UiRoot)" />
  </Target>

</Project>