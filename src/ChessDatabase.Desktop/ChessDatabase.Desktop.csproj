<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChessDatabase</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessDatabase.Api\ChessDatabase.Api.csproj" />
  </ItemGroup>

  <!-- The built Angular UI (ui/dist/ui/browser) is served from wwwroot next to the executable. -->
  <ItemGroup>
    <Content Include="..\..\ui\dist\ui\browser\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WarnWhenUiMissing" BeforeTargets="Build" Condition="!Exists('..\..\ui\dist\ui\browser\index.html')">
    <Warning Text="The Angular UI has not been built yet. Run ./build.ps1 (or 'npm run build' in ui/) so the desktop window has something to show." />
  </Target>

</Project>
